# .dockerignore
# Ignore files and directories that shouldn't be copied to the Docker image

# Git
.git
.gitignore
README.md

# Docker files
Dockerfile
docker-compose.yml
.dockerignore

# Go build artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
main

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Dependency directories
vendor/

# Go workspace file
go.work

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log

# Environment files
.env
.env.local
.env.*.local
